{
  "name": "lti-1-3-handshake-poc",
  "version": "1.0.0",
  "private": true,
  "description": "Self-contained LTI 1.3 OIDC launch handshake proof of concept",
  "main": "server.js",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "start": "node server.js",
    "test": "node scripts/launch.mjs",
    "demo": "node scripts/launch-browser.mjs",
    "test:dynreg": "node scripts/register-and-launch.mjs",
    "reset": "node scripts/reset-registration.mjs",
    "local": "pwsh -File scripts/run-local.ps1",
    "check": "node --check server.js && node --check scripts/setup.mjs && node --check scripts/launch.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "jose": "^5.9.6",
    "ltijs": "^5.9.5"
  },
  "devDependencies": {
    "playwright": "^1.47.0"
  }
}